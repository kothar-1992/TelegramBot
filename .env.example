# ---- Bot Token from @BotFather ----
BOT_TOKEN=your_bot_token_here

# ---- Admin Telegram numeric IDs (comma separated) ----
# Get yours by sending /id to the bot, or open https://t.me/userinfobot
ADMIN_IDS=

# ---- Store branding ----
SHOP_NAME=W3K Digital Pay & Services
CURRENCY=MMK
WELCOME_TEXT=👋 Welcome to {shop}
SUPPORT_USERNAME=

# 🏠 Menu reply button (welcome card ပေါ်တွင် ပေါ်လာမည်) — မလိုရင် false
MENU_BUTTON=true

# 🧹 အသုံးပြုသူရိုက်တဲ့ message တွေကို အလိုအလျောက်ဖျက်ပါမည် (admin များမပါ) — မလိုရင် false
CLEAN_MESSAGES=true

# 🔒 လက်ခံလို့ရတဲ့ ပုံအမြန်ဆုံး — Document/Video/Audio တွေ အလုံးလျက် ငြင်းမှတ်
MAX_UPLOAD_MB=10

# ⏱ Receipt စစ်ဆေးချိန် — ဒီအချိန်အတွင်း admin က မလုပ်ရင် အလိုအလျောက် ပယ်ဖျက်ပါမည်
REVIEW_MINUTES=15

# ---- Storage ----
DB_PATH=shop.db
PAGE_SIZE=6

# ---- Proxy ----
# Telegram block ထားတဲ့ နိုင်ငံတွေမှာ လိုအပ်ပါတယ်။ v2rayN = socks5://127.0.0.1:10809
# မလိုအပ်ရင် အလွတ်ထားခဲ့ပါ။
PROXY=

# ---- Free PaaS (Render စသည်) ----
# သင့် public URL — ၉ မိနစ်တိုင်း ping ပြီး free instance အိမ်ချမှုမှ ကားပေးမည်။
SELF_URL=
KEEPALIVE_MINUTES=9

# ---- အလိုအလ် သိမ်းဆည်းမှု ----
# deploy တိုင်း disk ပျက်သွားတာကို Telegram မှာ သိမ်းထားပြီး ပြန်ယူပါမည်။
BACKUP_ENABLED=false
BACKUP_ADMIN_ID=
BACKUP_MINUTES=10